    document.getElementById('province_id')?.addEventListener('change', function() {
        regionSelect.innerHTML = '<option>Chargement...</option>';
        fetch(`/regions/by-province/${this.value}`)
            .then(res => res.json())
            .then(data => {
                regionSelect.innerHTML = '<option value="">-- Sélectionner --</option>';
                data.forEach(r => regionSelect.innerHTML += `<option value="${r.id}">${r.nom}</option>`);
            });
    });
});
