<script>
document.addEventListener('DOMContentLoaded', function() {
    const departementDiv = document.getElementById('departement_div');
    const circonscriptionDiv = document.getElementById('circonscription_div');
    const districtDiv = document.getElementById('district_div');
    const formationDiv = document.getElementById('formation_div');

    const provinceDiv = document.getElementById('province_div');
    const regionDiv = document.getElementById('region_div');

    const autreDiv = document.getElementById('autre_div');
    const enseignementSelect = document.getElementById('enseignement_id');

    const circonscriptionSelect = document.getElementById('circonscription_id');
    const formationSelect = document.getElementById('formation_id');
    const districtSelect = document.getElementById('district_id');
    const regionSelect = document.getElementById('region_id');

    // Gestion du changement d'enseignement
    enseignementSelect.addEventListener('change', function() {
        const selectedText = this.options[this.selectedIndex].text.toLowerCase();

        // Autre
        if(selectedText === 'autre') {
            autreDiv.classList.remove('d-none');
        } else {
            autreDiv.classList.add('d-none');
        }

        // Maternel / Primaire
        if(selectedText === 'maternel' || selectedText === 'primaire') {
            departementDiv.classList.remove('d-none');
            circonscriptionDiv.classList.remove('d-none');
            districtDiv.classList.remove('d-none');
            formationDiv.classList.remove('d-none');

            provinceDiv.classList.add('d-none');
            regionDiv.classList.add('d-none');
        }
        // Secondaire / Autre
        else if(selectedText === 'secondaire' || selectedText === 'autre') {
            departementDiv.classList.add('d-none');
            circonscriptionDiv.classList.add('d-none');
            districtDiv.classList.add('d-none');
            formationDiv.classList.add('d-none');

            provinceDiv.classList.remove('d-none');
            regionDiv.classList.remove('d-none');
        }
    });

    // Chargement dynamique des circonscriptions
    document.getElementById('departement_id')?.addEventListener('change', function() {
        circonscriptionSelect.innerHTML = '<option>Chargement...</option>';
        fetch(`/circonscriptions/by-departement/${this.value}`)
            .then(res => res.json())
            .then(data => {
                circonscriptionSelect.innerHTML = '<option value="">-- Sélectionner --</option>';
                data.forEach(d => circonscriptionSelect.innerHTML += `<option value="${d.id}">${d.nom}</option>`);
            });
    });

    // Chargement dynamique des formations
    districtSelect?.addEventListener('change', function() {
        formationSelect.innerHTML = '<option>Chargement...</option>';
        fetch(`/formations/by-district/${this.value}`)
            .then(res => res.json())
            .then(data => {
                formationSelect.innerHTML = '<option value="">-- Sélectionner --</option>';
                data.forEach(f => formationSelect.innerHTML += `<option value="${f.id}">${f.nom}</option>`);
            });
